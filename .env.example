GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Worktrees can read a main checkout's real vault without copying or linking it.
# MC_VAULT_ROOT=C:/path/to/main-checkout/vault

# Optional shared semantic state; use absolute paths outside disposable worktrees.
# MC_SEMANTIC_DB=C:/path/to/asset-search.sqlite
# MC_SEMANTIC_MANIFEST=C:/path/to/approved-assets.json
# MC_SEMANTIC_QUOTA_DB=C:/path/to/embedding-requests.sqlite
MC_SEMANTIC_DAILY_LIMIT=1000
